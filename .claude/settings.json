{
  "extraKnownMarketplaces": {
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude"
      }
    }
  },
  "enabledPlugins": {
    "pstack@pstack-claude": true
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(gh pr merge*)",
      "Bash(gh * pr merge*)",
      "Bash(wrangler deploy*)",
      "Bash(npx wrangler deploy*)",
      "Bash(pnpm wrangler deploy*)",
      "Bash(pnpm exec wrangler deploy*)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "pnpm install --frozen-lockfile",
      "gh pr view *",
      "gh pr list*",
      "gh pr create *",
      "gh pr edit *",
      "gh pr checks *",
      "gh pr diff *",
      "gh pr ready *",
      "gh issue view *",
      "gh issue list*",
      "gh issue comment *",
      "gh api repos/*"
    ],
    "filesystem": {
      "allowWrite": [
        "~/Library/pnpm",
        "~/Library/Preferences/.wrangler/logs",
        "~/Library/Preferences/.wrangler/registry"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "registry.npmjs.org",
        "fonts.googleapis.com",
        "fonts.gstatic.com",
        "fonts.google.com",
        "github.com",
        "api.github.com",
        "workers.cloudflare.com"
      ]
    }
  }
}
