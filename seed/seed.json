{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Marketing Starter",
		"description": "A conversion-focused marketing site with landing pages",
		"author": "EmDash"
	},
	"settings": {
		"title": "GIKOU"
	},
	"blockTypes": [
		{
			"slug": "marketing_hero",
			"label": "Hero",
			"description": "A prominent page introduction with optional calls to action and media",
			"category": "Marketing",
			"currentVersion": 1,
			"versions": [
				{
					"version": 1,
					"fields": [
						{
							"slug": "anchor_id",
							"label": "Anchor ID",
							"type": "string",
							"validation": { "pattern": "^(?:$|[a-z][a-z0-9_-]*)$" }
						},
						{ "slug": "headline", "label": "Headline", "type": "string", "required": true },
						{ "slug": "subheadline", "label": "Subheadline", "type": "text" },
						{ "slug": "primary_cta_label", "label": "Primary CTA label", "type": "string" },
						{
							"slug": "primary_cta_url",
							"label": "Primary CTA URL",
							"type": "string",
							"validation": { "pattern": "^(?:$|(?:https?://|mailto:|tel:|/(?!/)|#).+)$" }
						},
						{ "slug": "secondary_cta_label", "label": "Secondary CTA label", "type": "string" },
						{
							"slug": "secondary_cta_url",
							"label": "Secondary CTA URL",
							"type": "string",
							"validation": { "pattern": "^(?:$|(?:https?://|mailto:|tel:|/(?!/)|#).+)$" }
						},
						{ "slug": "image", "label": "Image", "type": "image" },
						{
							"slug": "centered",
							"label": "Center the layout",
							"type": "boolean",
							"defaultValue": false
						}
					]
				}
			]
		},
		{
			"slug": "marketing_features",
			"label": "Features",
			"description": "A grid of product or service features",
			"category": "Marketing",
			"currentVersion": 1,
			"versions": [
				{
					"version": 1,
					"fields": [
						{
							"slug": "anchor_id",
							"label": "Anchor ID",
							"type": "string",
							"validation": { "pattern": "^(?:$|[a-z][a-z0-9_-]*)$" }
						},
						{ "slug": "headline", "label": "Headline", "type": "string", "required": true },
						{ "slug": "subheadline", "label": "Subheadline", "type": "text" },
						{
							"slug": "features",
							"label": "Features",
							"type": "repeater",
							"required": true,
							"validation": {
								"minItems": 1,
								"maxItems": 12,
								"subFields": [
									{
										"slug": "icon",
										"label": "Icon",
										"type": "select",
										"required": true,
										"options": [
											"zap",
											"shield",
											"users",
											"chart",
											"code",
											"globe",
											"heart",
											"star",
											"check",
											"lock",
											"clock",
											"cloud"
										]
									},
									{ "slug": "title", "label": "Title", "type": "string", "required": true },
									{
										"slug": "description",
										"label": "Description",
										"type": "text",
										"required": true
									}
								]
							}
						}
					]
				}
			]
		},
		{
			"slug": "marketing_testimonials",
			"label": "Testimonials",
			"description": "Customer quotes and attribution",
			"category": "Marketing",
			"currentVersion": 1,
			"versions": [
				{
					"version": 1,
					"fields": [
						{
							"slug": "anchor_id",
							"label": "Anchor ID",
							"type": "string",
							"validation": { "pattern": "^(?:$|[a-z][a-z0-9_-]*)$" }
						},
						{ "slug": "headline", "label": "Headline", "type": "string" },
						{
							"slug": "testimonials",
							"label": "Testimonials",
							"type": "repeater",
							"required": true,
							"validation": {
								"minItems": 1,
								"maxItems": 12,
								"subFields": [
									{ "slug": "quote", "label": "Quote", "type": "text", "required": true },
									{ "slug": "author", "label": "Author name", "type": "string", "required": true },
									{ "slug": "role", "label": "Role or title", "type": "string" },
									{ "slug": "company", "label": "Company", "type": "string" },
									{ "slug": "avatar", "label": "Avatar", "type": "image" }
								]
							}
						}
					]
				}
			]
		},
		{
			"slug": "marketing_pricing",
			"label": "Pricing",
			"description": "A comparison of up to three pricing plans",
			"category": "Marketing",
			"currentVersion": 1,
			"versions": [
				{
					"version": 1,
					"fields": [
						{
							"slug": "anchor_id",
							"label": "Anchor ID",
							"type": "string",
							"validation": { "pattern": "^(?:$|[a-z][a-z0-9_-]*)$" }
						},
						{ "slug": "headline", "label": "Headline", "type": "string" },
						{
							"slug": "plans",
							"label": "Plans",
							"type": "repeater",
							"required": true,
							"validation": {
								"minItems": 1,
								"maxItems": 3,
								"subFields": [
									{ "slug": "name", "label": "Plan name", "type": "string", "required": true },
									{ "slug": "price", "label": "Price", "type": "string", "required": true },
									{ "slug": "period", "label": "Period", "type": "string" },
									{ "slug": "description", "label": "Description", "type": "text" },
									{ "slug": "features", "label": "Features, one per line", "type": "text" },
									{ "slug": "cta_label", "label": "CTA label", "type": "string", "required": true },
									{ "slug": "cta_url", "label": "CTA URL", "type": "string", "required": true },
									{ "slug": "highlighted", "label": "Highlight this plan", "type": "boolean" }
								]
							}
						}
					]
				}
			]
		},
		{
			"slug": "marketing_faq",
			"label": "FAQ",
			"description": "A list of frequently asked questions",
			"category": "Marketing",
			"currentVersion": 1,
			"versions": [
				{
					"version": 1,
					"fields": [
						{
							"slug": "anchor_id",
							"label": "Anchor ID",
							"type": "string",
							"validation": { "pattern": "^(?:$|[a-z][a-z0-9_-]*)$" }
						},
						{ "slug": "headline", "label": "Headline", "type": "string" },
						{
							"slug": "items",
							"label": "Questions",
							"type": "repeater",
							"required": true,
							"validation": {
								"minItems": 1,
								"maxItems": 12,
								"subFields": [
									{ "slug": "question", "label": "Question", "type": "string", "required": true },
									{ "slug": "answer", "label": "Answer", "type": "text", "required": true }
								]
							}
						}
					]
				}
			]
		}
	],
	"collections": [
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"supports": ["drafts", "revisions", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "blocks",
					"validation": {
						"allowedTypes": [
							"marketing_hero",
							"marketing_features",
							"marketing_testimonials",
							"marketing_pricing",
							"marketing_faq"
						],
						"maxItems": 20
					}
				}
			]
		}
	],
	"menus": [
		{ "name": "primary", "label": "Primary Navigation", "items": [] },
		{ "name": "footer_product", "label": "Footer: Product", "items": [] },
		{ "name": "footer_company", "label": "Footer: Company", "items": [] },
		{ "name": "footer_support", "label": "Footer: Support", "items": [] }
	],
	"content": {
		"pages": []
	}
}
