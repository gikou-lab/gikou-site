{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gikou-site-web",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// workers.dev とプレビューの URL は出さない（ゾーンの守りを素通りされないため）
	"workers_dev": false,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gikou-site-db",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "gikou-site-media",
		},
	],
	// 内容の問い合わせの結果を置くオブジェクトキャッシュ（astro.config.mjs の kvCache と同じ binding）
	"kv_namespaces": [{ "binding": "CACHE" }],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
