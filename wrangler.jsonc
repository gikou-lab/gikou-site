{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gikou-site-web",
	// CI の deploy と emdash migrate が使う（鍵ではない）
	"account_id": "8f0f3fccdb1512e54711726c0ddf9584",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// workers.dev とプレビューの URL は出さない（ゾーンの守りを素通りされないため）
	"workers_dev": false,
	"preview_urls": false,
	// 公開の名前は apex の gikou.dev だけ。DNS の行は deploy のときに Cloudflare が作る
	"routes": [{ "pattern": "gikou.dev", "custom_domain": true }],
	"vars": {
		"EMDASH_SITE_URL": "https://gikou.dev",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gikou-site-db",
			"database_id": "3bfd1f65-c63a-49c2-88a7-d00e4a06169d",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "gikou-site-media",
		},
	],
	// 内容の問い合わせの結果を置くオブジェクトキャッシュ（astro.config.mjs の kvCache と同じ binding）
	// SESSION は Astro の Cloudflare adapter がログインの状態に使う。番号を書かないと deploy のたびに作り直そうとする
	"kv_namespaces": [
		{ "binding": "CACHE", "id": "d9efb031cc694f5f86deb9b2e40c835d" },
		{ "binding": "SESSION", "id": "27e7469e69064c70b4e08d69deb2ba2f" },
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
